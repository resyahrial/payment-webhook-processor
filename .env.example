PORT=8080
APP_ENV=development
WEBHOOK_SIGNING_SECRET=dev-webhook-signing-secret
POSTGRES_DB=payments
POSTGRES_USER=payments
POSTGRES_PASSWORD=payments
DATABASE_URL=postgres://payments:payments@postgres:5432/payments?sslmode=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=30m
K6_WEBHOOK_BASE_URL=http://localhost:8080
K6_NORMAL_RATE=5
K6_SPIKE_RATE=2000
K6_CAPACITY_START_RATE=10
K6_CAPACITY_PEAK_RATE=250
K6_NOISY_BASELINE_RATE=5
K6_NOISY_SPIKE_START_RATE=20
K6_NOISY_SPIKE_PEAK_RATE=200
K6_HOT_PAYMENT_RATE=150
K6_HOT_PAYMENT_SET_SIZE=5
K6_OUT_OF_ORDER_RATE=300
K6_OUT_OF_ORDER_PAYMENT_SET_SIZE=20
